# OS
.DS_Store
Thumbs.db

# Editors and IDEs
.idea/
*.iml
.vscode/
*.code-workspace
*.swp

# Local AI-assistant config (desktop preview servers, personal settings)
.claude/

# Secrets and local environment files
.env*
!.env.example
*.pem

# Logs and run output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python (backend/, tests/, tools/)
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# Node / Next.js (web/, frontend/ — each also has its own .gitignore)
node_modules/
.next/
/web/out/
/frontend/dist/
*.tsbuildinfo
next-env.d.ts
.vercel/
coverage/

# Yarn / pnpm (the repo uses npm, but keep other package managers' state out)
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Browser-automation scratch output (tools/record_deepchart_demo.cjs)
.playwright-mcp/

# Recorded agent runs. Live runs are written here and are not committed;
# demo.jsonl is the replay the deploy uses (MODE=replay), so it is kept.
backend/agents/replays/*.jsonl
!backend/agents/replays/demo.jsonl

# HopHacks event documents (kept locally, not published)
/hophacks-docs/
